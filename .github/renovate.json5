{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'gomod',
    'github-actions',
    'custom.regex',
    'dockerfile',
  ],
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
        '/^\\.github/workflows/ci\\.yaml$/',
      ],
      matchStrings: [
        'GOLANGCILINT_VERSION \\?= (?<currentValue>\\S+)',
        "GOLANGCI_VERSION: 'v(?<currentValue>[^']+)'",
      ],
      depNameTemplate: 'golangci/golangci-lint',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^go\\.mod$/',
        '/^\\.github/workflows/publish-pkg\\.yaml$/',
      ],
      matchStrings: [
        '\\ngo (?<currentValue>\\d+\\.\\d+\\.\\d+)',
        "go-version:[\\s\\S]*?default: '(?<currentValue>[^']+)'",
      ],
      depNameTemplate: 'go',
      datasourceTemplate: 'golang-version',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'KIND_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'kubernetes-sigs/kind',
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'UPTEST_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'crossplane/uptest',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'CRDDIFF_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'upbound/uptest',
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'CROSSPLANE_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'crossplane/crossplane',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'CROSSPLANE_CLI_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'KUBECTL_VALIDATE_VERSION \\??= (?<currentValue>\\S+)',
      ],
      depNameTemplate: 'kubernetes-sigs/kubectl-validate',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yaml$/',
      ],
      matchStrings: [
        "DOCKER_BUILDX_VERSION: '(?<currentValue>[^']+)'",
      ],
      depNameTemplate: 'docker/buildx',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/supplychain\\.yaml$/',
      ],
      matchStrings: [
        'UP_VERSION: (?<currentValue>v\\S+)',
      ],
      depNameTemplate: 'upbound/up',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      groupName: 'go modules',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'k8s.io/api',
        'k8s.io/apiextensions-apiserver',
        'k8s.io/apimachinery',
        'k8s.io/client-go',
        'k8s.io/code-generator',
        'k8s.io/component-base',
        'sigs.k8s.io/controller-runtime',
        'sigs.k8s.io/controller-tools',
      ],
      groupName: 'kubernetes',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'github.com/crossplane/crossplane-runtime/v2',
      ],
      groupName: 'crossplane-runtime',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'github.com/crossplane/crossplane-tools',
      ],
      groupName: 'crossplane-tools',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'golangci/golangci-lint',
      ],
      groupName: 'golangci-lint',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'go',
      ],
      groupName: 'go',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
        'toolchain',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'github.com/anthropics/anthropic-sdk-go',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchPackageNames: [
        'gcr.io/distroless/static-debian13',
      ],
      pinDigests: true,
      groupName: 'runtime image',
    },
  ],
}
